{
  "family": "payflow",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::473231598624:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "payflow-api",
      "image": "473231598624.dkr.ecr.us-east-1.amazonaws.com/payflow:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payflow",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "payflow"
        }
      }
    }
  ]
}
