{
  "containerDefinitions": [
    {
      "name": "payflow-api",
      "image": "473231598624.dkr.ecr.us-east-1.amazonaws.com/payflow:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DJANGO_ALLOWED_HOSTS",
          "value": "*"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payflow",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "payflow"
        }
      },
      "systemControls": []
    }
  ],
  "family": "payflow",
  "executionRoleArn": "arn:aws:iam::473231598624:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}